# Copy this file to `.env` and fill in real values, OR set the same keys
# directly in the process environment (e.g. via Docker / systemd / CI).
#
# After Phase 2 lands, settings read os.environ first, then fall back to
# `.env`, so a `.env` file is not required when env vars are supplied
# another way. Only SECRET_KEY is mandatory; everything else has sensible
# defaults.

# Random string used for cryptographic signing. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me

# Comma-separated hostnames Django will accept. Defaults to
# `127.0.0.1,localhost` in dev and `.literature.learnche.org,127.0.0.1`
# in prod. Override only when deploying under a different hostname.
#ALLOWED_HOSTS=.literature.learnche.org,127.0.0.1

# Postgres connection details. Consulted by both `literature.settings.dev`
# and `literature.settings.prod`. Dev defaults to the values below
# (literature/literature/literature@127.0.0.1:5432) so a freshly cloned
# checkout boots once you've created a local DB:
#
#     sudo -u postgres psql -c "CREATE USER literature WITH PASSWORD 'literature';"
#     sudo -u postgres psql -c "CREATE DATABASE literature OWNER literature;"
#
# Override these env vars (or set them blank in prod) as needed. Phase 7
# will add a docker-compose.yml that boots Postgres in a sidecar
# container so the host install is optional.
POSTGRES_DB=literature
POSTGRES_USER=literature
POSTGRES_PASSWORD=literature
SQL_HOST=127.0.0.1
SQL_PORT=5432

# Off-host backups. Consumed by bin/backup-literature.sh on the Hetzner
# host (Phase 11). Leave blank in dev — the script is only run from the
# prod VPS.
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=
#AWS_DEFAULT_REGION=eu-central-1
#BACKUP_S3_BUCKET=
#BACKUP_S3_PREFIX=literature
